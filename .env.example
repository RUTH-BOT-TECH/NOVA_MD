# ── identity ────────────────────────────────────────────────────────────
BOT_NAME=NOVA-MD
OWNER_NAME=Your Name
OWNER_NUMBER=2348123456789          # your WhatsApp number, international, digits only
EXTRA_OWNERS=                        # comma separated extra owner numbers
REPO_URL=https://github.com/RUTH-BOT-TECH/NOVA_MD

# ── behaviour ───────────────────────────────────────────────────────────
PREFIXES=.
MODE=public                          # public | self (owner-only)
AUTO_READ=false
AUTO_TYPING=false
COMMAND_COOLDOWN_MS=1500
TZ=Africa/Lagos

# ── login ───────────────────────────────────────────────────────────────
# Leave PAIRING_NUMBER empty to log in with a QR code instead.
PAIRING_NUMBER=                      # e.g. 2348123456789
BROWSER=NOVA-MD

# ── session storage ─────────────────────────────────────────────────────
SESSION_BACKEND=file                 # file | supabase
SESSION_DIR=sessions

# only needed when SESSION_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SESSION_ID=main
SUPABASE_CREDS_TABLE=wa_creds
SUPABASE_KEYS_TABLE=wa_signal_keys

# ── misc ────────────────────────────────────────────────────────────────
NODE_ENV=development                 # production on a host (many set this for you)
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=silent
PORT=0                               # >0 starts GET /health (handy on Render/Koyeb)

# ── session from the pairing website (alternative to QR / file) ──────────
SESSION_ID=                          # base64 creds or NOVA~... — set this and you skip QR entirely
                                    # or set SESSION_BACKEND=session to force it

# ── pairing website (web/) ──────────────────────────────────────────────
# public URL of the deployed pairing site (shown in .menu so users can pair)
# e.g. PAIR_URL=https://nova-pair.up.railway.app
PAIR_URL=
WEB_PORT=3000
MAX_ACTIVE=3                         # concurrent pairing sockets
PER_IP=5                             # pairing attempts per IP per window
WINDOW_MS=600000
LINK_TIMEOUT_MS=240000               # how long a code stays valid
SESSION_PREFIX=NOVA                  # prefix on the SESSION_ID the site hands out
ADMIN_TOKEN=                         # set to expose GET /api/jobs

# ── contact card / "verified" look ──────────────────────────────────────
# The ✓ on the card is a character in the contact's display name, not Meta
# verification. Set NAME_TICK= to remove it entirely.
NAME_TICK=✓
BRAND_CARD=true                      # send the card before .menu

# ── menu host label ─────────────────────────────────────────────────────
# Auto-detected (Railway / Render / Koyeb / Fly / Heroku / Vercel / Netlify /
# Codespaces / Replit / Pterodactyl / Termux / GCP / Azure / AWS / Docker / VPS).
# Override it if you self-host or the label comes out wrong:
HOST_NAME=

# ── AI (any one key enables .ai / .gpt / .gemini) ───────────────────────
AI_PROVIDER=                        # force one: gemini | groq | openai | openrouter | deepseek
GEMINI_API_KEY=                     # free tier at aistudio.google.com
GROQ_API_KEY=                       # free tier at console.groq.com
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
AI_MAX_TOKENS=512
AI_MEMORY_TURNS=12
AI_TIMEOUT_MS=45000
# AI_SYSTEM_PROMPT=You are NOVA-MD, a concise WhatsApp assistant.
# OPENAI_BASE_URL=https://api.openai.com/v1     # point at any compatible endpoint

# ── downloads (yt-dlp binary, no npm deps) ──────────────────────────────
YTDLP_PATH=yt-dlp                   # or /usr/local/bin/yt-dlp
YTDLP_COOKIES=                      # cookies.txt — fixes YouTube "Sign in to confirm you're not a bot"
YTDLP_COOKIES_FROM_BROWSER=         # e.g. chrome (needs a local browser profile)
YTDLP_EXTRACTOR_ARGS=               # e.g. youtube:player_client=android,ios
YTDLP_PROXY=
MAX_DOWNLOAD_MB=48
YTDLP_DOWNLOAD_TIMEOUT_MS=180000

# ── weather ─────────────────────────────────────────────────────────────
DEFAULT_CITY=

# ── YouTube strategies (pick whichever your host can use) ───────────────
# Tried in order: external api → piped → invidious → yt-dlp → ytdl-core.
# Most public bots simply call someone else's downloader API — that is the
# setting below. Any endpoint that returns JSON containing a direct media
# URL works; {url} {id} {mode} {key} are substituted.
DOWNLOAD_API_URL=                  # e.g. https://api.example.com/ytdl?url={url}&apikey={key}
DOWNLOAD_API_KEY=

PIPED_URL=                         # e.g. https://pipedapi.kavin.rocks  (must be a live instance)
INVIDIOUS_URL=                     # e.g. https://inv.nadeko.net        (must be a live instance)

# ── economy ─────────────────────────────────────────────────────────────
CURRENCY_NAME=Nova
CURRENCY_SYMBOL=₦
ECONOMY_DAILY=2500          # .daily payout (streak multiplies it)
ECONOMY_START=1000          # opening balance for a new user
